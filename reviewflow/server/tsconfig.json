{
  // Node runs the TypeScript sources directly in development (type stripping,
  // built in since Node 22.18), and `npm run build` emits plain JS for the
  // production image. Two rules make both paths work from one source tree:
  //
  //   erasableSyntaxOnly  — bans syntax Node cannot strip (enums, namespaces,
  //                         parameter properties), so `node src/index.ts` and
  //                         `tsc` never disagree.
  //   rewriteRelativeImportExtensions
  //                       — lets us import "./foo.ts" (what Node's loader
  //                         wants) while tsc rewrites it to "./foo.js" on emit.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
