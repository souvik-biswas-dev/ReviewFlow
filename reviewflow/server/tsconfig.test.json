// Type-checks the test suite, which lives outside src/ (and therefore outside
// the build's rootDir) so test files never end up in the production image.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
