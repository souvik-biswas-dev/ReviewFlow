{
  "name": "reviewflow-server",
  "version": "1.0.0",
  "description": "ReviewFlow backend — Express + GraphQL + WebSocket hub + Gemini AI reviews",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@graphql-tools/schema": "^10.0.38",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-http": "^1.22.4",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
