# Copy to .env:  cp .env.example .env
# The Go server reads reviewflow/.env automatically (real env vars win).

# --- HTTP --------------------------------------------------------------------
PORT=8080
ENVIRONMENT=development

# Browser origins allowed to call the API / open WebSockets (comma-separated).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB -----------------------------------------------------------------
# Running the server on your host: localhost. (docker compose overrides this
# to the "mongo" service for you.)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=reviewflow

# --- Sessions ----------------------------------------------------------------
# Required in production (>= 32 chars):  openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me

# --- Sign-in -----------------------------------------------------------------
# Guest login: pick a name and go. No GitHub app needed; ideal for trying the
# tool with two browser windows. Default: on in development, off in production.
ALLOW_GUEST_LOGIN=true

# GitHub OAuth (optional). Register an app at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback
# Where the browser is sent after login.
FRONTEND_URL=http://localhost:5173

# --- AI (Google Gemini) ------------------------------------------------------
# Free key: https://aistudio.google.com/apikey   Leave empty to disable AI.
GEMINI_API_KEY=
# Model IDs get retired quickly (gemini-2.0-flash died 2026-06-01 and
# gemini-2.5-flash was scheduled for 2026-10-16). If reviews fail with
# "model not found", pick a current ID from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
# Self-imposed ceiling, kept under the free tier's 15 RPM.
AI_REQUESTS_PER_MINUTE=10
# Budget for one review including its single quota retry.
AI_TIMEOUT_SECONDS=30
